# Backend environment contract (copy to .env and fill in values)

# PostgreSQL connection string
DATABASE_URL=

# JWT signing secret — REQUIRED. Use at least 32 random characters.
JWT_SECRET=
# Access-token lifetime (jsonwebtoken format). Short-lived by design; the
# refresh flow renews it silently. Default: 15m
JWT_EXPIRES_IN=15m
# Refresh-token lifetime in days. Refresh tokens rotate on every use and are
# revoked server-side on logout. Default: 7
REFRESH_TOKEN_TTL_DAYS=7

# AI provider — Cloudflare Workers AI (OpenAI-compatible endpoint).
# Variable names keep the ZAI_* contract; values point to Cloudflare.
# Obtain a token with Workers AI inference permission (`wrangler auth token`).
ZAI_API_KEY=
ZAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
ZAI_MODEL_REASONING=@cf/zai-org/glm-4.7-flash
ZAI_MODEL_GENERAL=@cf/zai-org/glm-4.7-flash
ZAI_MODEL_FAST=@cf/zai-org/glm-4.7-flash
ZAI_MODEL_ASR=@cf/openai/whisper-large-v3-turbo

# Cross-site auth cookies (frontend *.workers.dev → API *.workers.dev)
COOKIE_SAMESITE=none

# Server
PORT=4000
# Comma-separated list of allowed frontend origins (CORS, credentials)
FRONTEND_URL=https://speakio-web.speakio.workers.dev,http://localhost:3000

# Password reset email (Cloudflare Email Sending REST; optional in dev)
CF_EMAIL_API_TOKEN=
CF_ACCOUNT_ID=
CF_EMAIL_FROM=

# Seed credentials (development only). Privileged seed users are skipped and
# seeding without SEED_PASSWORD is refused when NODE_ENV=production.
SEED_PASSWORD=
