# Public API base URL. Production uses the SAME-ORIGIN /api path on the
# frontend Worker (web-worker-entry.js proxies /api/* to speakio-api).
# This is required because auth cookies cannot be shared between two
# *.workers.dev subdomains (workers.dev is on the Public Suffix List).
# For local development against the NestJS backend use http://localhost:4040.
NEXT_PUBLIC_API_URL=https://speakio-web.speakio.workers.dev/api
