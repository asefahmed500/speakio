                 │  └─────────┘ └──────────────┘ │
                 │  ┌─────────┐ ┌──────────────┐ │
                 │  │ Content  │ │ Review        │ │
                 │  │ Gen Agent│ │ Triage Agent  │ │
                 │  └─────────┘ └──────────────┘ │
                 │  ┌─────────┐ ┌──────────────┐ │
                 │  │ Coach    │ │ Certificate   │ │
                 │  │ Agent    │ │ Agent         │ │
                 │  └─────────┘ └──────────────┘ │
                 │  ┌─────────┐ ┌──────────────┐ │
                 │  │Notification│ Ops/Support  │ │
                 │  │ Agent    │ │ Agent         │ │
                 │  └─────────┘ └──────────────┘ │
                 │  Agent run log → Admin Ops UI  │
                 └───────┬─────────────────────┘
        ┌────────────────┼────────────────┬───────────────┐
        ▼                ▼                ▼               ▼
  ┌───────────┐   ┌─────────────┐  ┌─────────────┐  ┌───────────┐
  │ PostgreSQL │   │ Redis/BullMQ │  │ Claude API   │  │ S3/Storage │
  │ (Prisma)   │   │ (jobs/queue) │  │ + STT vendor │  │ (audio/PDF)│
